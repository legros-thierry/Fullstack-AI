      "updated": 1789462244230,
      "created": 1789461959672,
      "link": null,
      "locked": false,
      "text": "class nom_de_classe():\n    def __init__():\n        construire les \n        variables encapsulées\n    \n    def fonction1():\n        methode 1\n        return .. \n\n    def fonction2():\n        methode2\n        return ...\n\n        ....\n\n\nobjet = nom_de_classe()\n\nprint(objet.attribut1)\n\n\nprint(objet.fonction2(var))\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class nom_de_classe():\n    def __init__():\n        construire les \n        variables encapsulées\n    \n    def fonction1():\n        methode 1\n        return .. \n\n    def fonction2():\n        methode2\n        return ...\n\n        ....\n\n\nobjet = nom_de_classe()\n\nprint(objet.attribut1)\n\n\nprint(objet.fonction2(var))\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
