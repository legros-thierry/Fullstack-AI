      "isDeleted": false,
      "boundElements": [],
      "updated": 1789547195019,
      "created": 1789547153007,
      "link": null,
      "locked": false,
      "text": "on a la capacité de revenir en arriere d'avancer\nrevenir et repartir : plutot que fichier1.word fichier2.word\n                                        fichier_revu_par_nplus1_mardi.word",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
