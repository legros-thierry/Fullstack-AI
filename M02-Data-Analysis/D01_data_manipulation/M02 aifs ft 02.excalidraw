    {
      "id": "bHuGJ8UJIilCDhRTU1Qdb",
      "type": "text",
      "x": 395.00449741454963,
      "y": 1512.9974198664713,
      "width": 1160.4241943359375,
      "height": 585,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a5",
      "roundness": null,
      "seed": 816909705,
      "version": 643,
      "versionNonce": 1022654825,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789633064201,
      "created": 1789632293000,
      "link": null,
      "locked": false,
      "text": "=> ce qu'on veut nous c'est manipuler de la donnée\n-> on se lance directement dans numpy PUIS pandas\n    => numpy est la libraire deluxe quand il s'agit de manipuler \n        arrays de nombres => liste, tableau, tensor\n        => numpy en plus de nous accorder enormément \n        de fonctionnalités pour gérer ces types de données\n        optimise les transformations et les processus \n\n            => bémol : on a de la structure mais on n'a pas le cadre\n                        \"langage naturel\" \n                    => pandas : a récupéré la techno de numpy\n                                et a rajouté une couche supplémentaire \n                                orientée DATA",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "=> ce qu'on veut nous c'est manipuler de la donnée\n-> on se lance directement dans numpy PUIS pandas\n    => numpy est la libraire deluxe quand il s'agit de manipuler \n        arrays de nombres => liste, tableau, tensor\n        => numpy en plus de nous accorder enormément \n        de fonctionnalités pour gérer ces types de données\n        optimise les transformations et les processus \n\n            => bémol : on a de la structure mais on n'a pas le cadre\n                        \"langage naturel\" \n                    => pandas : a récupéré la techno de numpy\n                                et a rajouté une couche supplémentaire \n                                orientée DATA",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
