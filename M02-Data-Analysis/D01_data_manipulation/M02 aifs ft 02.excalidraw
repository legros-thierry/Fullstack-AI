    {
      "id": "O1gfczrUD_fFnucsgn3B3",
      "type": "text",
      "x": 252.55495784557826,
      "y": 398.45537964170836,
      "width": 1700.56298828125,
      "height": 889.3971450911124,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a3",
      "roundness": null,
      "seed": 2112887975,
      "version": 1180,
      "versionNonce": 1103834473,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789631923892,
      "created": 1789630821780,
      "link": null,
      "locked": false,
      "text": "Maintenant on veut travailler de la data \n    => tant qu'à faire, est ce qu'il n'existerait des librairies qui aient\n        deja fait tout le travail pour nous ? \n            => en data on ne part jamais de ZERO\n                => on part toujours du travail de personnes (qui avaient plus de temps que nous)\n                des librairies (ou package) python avec leurs propres et leurs propres objets\n\n\n        => en tant qu'ingénieur data ou data machin chouette :\n                - etre capable de determiner QUELLES librairies seront necessaires\n                pour notre projet => benchmark, newsletter, linkedin, collegues\n                => permet de definir notre STACK technique \n\n                - adapter les versions des librairies suivant notre use case\n\n                - il faut apprendre à utiliser nos librairies dans nos cad pratiques \n                        => chaque nouvelle librairie python que l'on va decouvrir ensemble\n                        a ses propres fonctionnements \n                                => la seule chose qui ne changera pas : \n                                        - on va manipuler des objets avec des attributs et des methodes",
      "fontSize": 35.575885803644496,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Maintenant on veut travailler de la data \n    => tant qu'à faire, est ce qu'il n'existerait des librairies qui aient\n        deja fait tout le travail pour nous ? \n            => en data on ne part jamais de ZERO\n                => on part toujours du travail de personnes (qui avaient plus de temps que nous)\n                des librairies (ou package) python avec leurs propres et leurs propres objets\n\n\n        => en tant qu'ingénieur data ou data machin chouette :\n                - etre capable de determiner QUELLES librairies seront necessaires\n                pour notre projet => benchmark, newsletter, linkedin, collegues\n                => permet de definir notre STACK technique \n\n                - adapter les versions des librairies suivant notre use case\n\n                - il faut apprendre à utiliser nos librairies dans nos cad pratiques \n                        => chaque nouvelle librairie python que l'on va decouvrir ensemble\n                        a ses propres fonctionnements \n                                => la seule chose qui ne changera pas : \n                                        - on va manipuler des objets avec des attributs et des methodes",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
