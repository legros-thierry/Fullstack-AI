      "boundElements": [],
      "updated": 1790070145114,
      "created": 1790070104926,
      "link": null,
      "locked": false,
      "text": "\"la variable aléatoire X suit \nune loi Binomiale de parametre\nn et p\" \noù n est le nombre d'épreuves de Bernoulli\net p est la probabilité d'un succès",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"la variable aléatoire X suit \nune loi Binomiale de parametre\nn et p\" \noù n est le nombre d'épreuves de Bernoulli\net p est la probabilité d'un succès",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
