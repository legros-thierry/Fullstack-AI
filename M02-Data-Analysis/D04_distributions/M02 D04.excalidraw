    {
      "id": "abwt1zpntgVhHZohHxgXj",
      "type": "text",
      "x": 2128.3957944883514,
      "y": 17645.877427731244,
      "width": 1299.38427734375,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1U",
      "roundness": null,
      "seed": 1288265223,
      "version": 370,
      "versionNonce": 1772946791,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790071756333,
      "created": 1790071658005,
      "link": null,
      "locked": false,
      "text": "Une variable aléatoire doit etre modélisée par une loi de probabilité\ndepuis tout à l'heure les variables aléatoires que je regarde correspondent\nà des problèmes discrets \n    => et si ma variable aléatoire correspond à une donnée continue ? \n            => on va la modeliser par une loi de probabilité continue ",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Une variable aléatoire doit etre modélisée par une loi de probabilité\ndepuis tout à l'heure les variables aléatoires que je regarde correspondent\nà des problèmes discrets \n    => et si ma variable aléatoire correspond à une donnée continue ? \n            => on va la modeliser par une loi de probabilité continue ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
