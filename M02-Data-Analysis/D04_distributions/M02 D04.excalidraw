      ],
      "updated": 1790070244632,
      "created": 1790070168059,
      "link": null,
      "locked": false,
      "text": "on peut modeliser le probleme \"how many of the next 10 promoted posts will be clicked\"\npar une loi binomiale \n    n = 10\n    p = reste à definir quelle est la probabilité qu'un post sponsorisé soit cliqué",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "on peut modeliser le probleme \"how many of the next 10 promoted posts will be clicked\"\npar une loi binomiale \n    n = 10\n    p = reste à definir quelle est la probabilité qu'un post sponsorisé soit cliqué",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
