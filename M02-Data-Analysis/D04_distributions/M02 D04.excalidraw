    },
    {
      "id": "rEcnIxZiKrA4j1_jmVr16",
      "type": "text",
      "x": 189.76189523831624,
      "y": 142.05582754798377,
      "width": 1160.244140625,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a7",
      "roundness": null,
      "seed": 2084295943,
      "version": 464,
      "versionNonce": 1228594407,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790063729689,
      "created": 1790063589023,
      "link": null,
      "locked": false,
      "text": "=> une branche des maths\n    => on y fait quoi ? \n        -> on cherche des tendances sur des \"grandes\" populations\n        -> on observe ce qui s'est passé et on cherche à en deduire\n        des previsions/predictions\n        -> on essaie de faire parler les chiffres\n\n=> objet d'etude : on rassemble des nombres\n                       et on essaie d'en sortir lois\n                       des tendances, des predictions",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "=> une branche des maths\n    => on y fait quoi ? \n        -> on cherche des tendances sur des \"grandes\" populations\n        -> on observe ce qui s'est passé et on cherche à en deduire\n        des previsions/predictions\n        -> on essaie de faire parler les chiffres\n\n=> objet d'etude : on rassemble des nombres\n                       et on essaie d'en sortir lois\n                       des tendances, des predictions",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
