      "frameId": null,
      "index": "b2Q",
      "roundness": null,
      "seed": 1236629076,
      "version": 262,
      "versionNonce": 1542118740,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790845984507,
      "created": 1790845787135,
      "link": null,
      "locked": false,
      "text": "=> le bruit : ne dépend pas de nous \n        => on ne s'en occupe pas\n\n=> le biais : depend de mu, donc de \n    notre estimateur f_approx \n        => on a la main\n\n=> la variance de f_approx : dépend de\nf_approx donc on a la main  ",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "=> le bruit : ne dépend pas de nous \n        => on ne s'en occupe pas\n\n=> le biais : depend de mu, donc de \n    notre estimateur f_approx \n        => on a la main\n\n=> la variance de f_approx : dépend de f_approx donc on a la main  ",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
