    {
      "id": "KJOQLiJqf38N14LTGFlt_",
      "type": "text",
      "x": 2133.46106083385,
      "y": 9478.141102224485,
      "width": 800,
      "height": 765,
      "angle": 0,
      "strokeColor": "#2f9e44",
