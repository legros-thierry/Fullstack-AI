      "created": 1790845718720,
      "link": null,
      "locked": false,
      "text": "=> tous positif : donc minimiser ma fonction\ncout en moyenne reviendra à minimiser tout\nces termes",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "=> tous positif : donc minimiser ma fonction cout en moyenne reviendra à minimiser tout ces termes",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "KRfspFqNjMtokxhOebrdb",
      "type": "text",
      "x": 1314.791355329207,
      "y": 7393.165378144588,
      "width": 800,
      "height": 405,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
