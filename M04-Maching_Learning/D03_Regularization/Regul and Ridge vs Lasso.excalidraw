      "seed": 192520148,
      "version": 601,
      "versionNonce": 779726164,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "-N7jO6iFLjK-SyNMIUFiy",
          "type": "arrow"
        }
      ],
      "updated": 1790848981025,
      "created": 1790848136985,
      "link": null,
      "locked": false,
      "text": "DANS RIDGE\nsi j'augmente lambda\n=> + lambda est grand \n    => biais => tend vers le biais initial\n    => variance => tend vers 0\n          => top on minimise le cout \n          MAIS comme dans ma fonction\n          cout il y a aussi lambda\n          necessairement le terme en \n          va \"s'écraser\" \n          => uniformement\n          mes betas seront plus petits\n          => des parametres tres faible \n          qui ne permettent pas en moyenne de\n          de bien predire => la distance entre\n          mu et f reele va augmenter\n            => on augmente le biais",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DANS RIDGE\nsi j'augmente lambda\n=> + lambda est grand \n    => biais => tend vers le biais initial\n    => variance => tend vers 0\n          => top on minimise le cout \n          MAIS comme dans ma fonction\n          cout il y a aussi lambda\n          necessairement le terme en \n          va \"s'écraser\" \n          => uniformement\n          mes betas seront plus petits\n          => des parametres tres faible \n          qui ne permettent pas en moyenne de\n          de bien predire => la distance entre\n          mu et f reele va augmenter\n            => on augmente le biais",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
