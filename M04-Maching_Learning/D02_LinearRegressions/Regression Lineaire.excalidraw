    {
      "id": "CxhO8bVaw9f_Ce8KgPWnf",
      "type": "text",
      "x": -76.30679537704111,
      "y": 4805.179989201483,
      "width": 1482.6964111328125,
      "height": 495,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
