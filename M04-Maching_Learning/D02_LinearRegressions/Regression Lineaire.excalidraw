      "frameId": null,
      "index": "ao",
      "roundness": null,
      "seed": 1947238811,
      "version": 680,
      "versionNonce": 314485275,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790757452529,
      "created": 1790757133314,
      "link": null,
      "locked": false,
      "text": "Attention ici on cherche une relation lineaire entre X et y\n    => on cherche donc une dependance lineaire entre X et y\n        => on cherche une dependance entre l'ensemble de mes colonnes\n        explicatives et y \n            => quid du fait que des colonnes soient en relations\n            lineaires entre elles ? \n                => si elles sont lineaires entre elles, elles portent la meme information\n                lineaire, la meme variance\n                        => cette relation va venir polluer mon modele\n            => ce que l'on veut c'est avoir des colonnes independantes\n                => il existe des outils dans scikit-learn pour determiner ces colinéarités",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Attention ici on cherche une relation lineaire entre X et y\n    => on cherche donc une dependance lineaire entre X et y\n        => on cherche une dependance entre l'ensemble de mes colonnes\n        explicatives et y \n            => quid du fait que des colonnes soient en relations\n            lineaires entre elles ? \n                => si elles sont lineaires entre elles, elles portent la meme information\n                lineaire, la meme variance\n                        => cette relation va venir polluer mon modele\n            => ce que l'on veut c'est avoir des colonnes independantes\n                => il existe des outils dans scikit-learn pour determiner ces colinéarités",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
