    {
      "id": "xTZZtMNFgdYtcPcg4jZ9O",
      "type": "text",
      "x": 3493.4046461778526,
      "y": 14184.065094105103,
      "width": 1640.7216796875,
      "height": 456.9873543905087,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3k",
      "roundness": null,
      "seed": 1555546005,
      "version": 576,
      "versionNonce": 352914837,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790763810352,
      "created": 1790763651957,
      "link": null,
      "locked": false,
      "text": "Quand on evalue UN modele on regarde deux choses \n    => son score sur la métrique sur la donnée d'entrainement \n    => mais aussi sur la donnée d'evaluation \n Regarder un modele par rapport à sa donnée d'entrainement c'est savoir\n si le modele a bien appris de sa donnée \n Regarder un modele par rapport à sa donnée de test (d'évaluation)\n c'est savoir si le modele est ROBUSTE => si il est aussi bon dans le cas\n                                                    d'une donnée qu'il n'a PAS vu ",
      "fontSize": 45.69873543905087,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Quand on evalue UN modele on regarde deux choses \n    => son score sur la métrique sur la donnée d'entrainement \n    => mais aussi sur la donnée d'evaluation \n Regarder un modele par rapport à sa donnée d'entrainement c'est savoir\n si le modele a bien appris de sa donnée \n Regarder un modele par rapport à sa donnée de test (d'évaluation)\n c'est savoir si le modele est ROBUSTE => si il est aussi bon dans le cas\n                                                    d'une donnée qu'il n'a PAS vu ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
