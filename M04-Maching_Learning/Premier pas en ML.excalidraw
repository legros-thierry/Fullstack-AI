    {
      "id": "1BsDRfecY3JDchX8_19If",
      "type": "text",
      "x": 238.00541750446723,
      "y": 7401.235933448774,
      "width": 1403.7481689453125,
      "height": 540,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0A",
      "roundness": null,
      "seed": 455581327,
      "version": 683,
      "versionNonce": 1254919617,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790670983615,
      "created": 1790670227111,
      "link": null,
      "locked": false,
      "text": "différents types de data \n    => données structurées (variables)\n        -> quantitative/numerique :\n            - continue : infinité de valeurs dans un intervalle donnée\n                => taille, poids, distance, salaire, durée, temperature\n            - discret : des valeurs denombrables => on peut les numéroter/compter\n                => année, nombre de personnes, nombres de pieces logement\n                    age, notes (entre 0 et 20 à 2 chiffres max apres la virgule)\n            \n        -> qualitative/categorielle\n            - nominal : sans ordre, sans hiérarchie \n                        des categories au sens propre du terme ",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "différents types de data \n    => données structurées (variables)\n        -> quantitative/numerique :\n            - continue : infinité de valeurs dans un intervalle donnée\n                => taille, poids, distance, salaire, durée, temperature\n            - discret : des valeurs denombrables => on peut les numéroter/compter\n                => année, nombre de personnes, nombres de pieces logement\n                    age, notes (entre 0 et 20 à 2 chiffres max apres la virgule)\n            \n        -> qualitative/categorielle\n            - nominal : sans ordre, sans hiérarchie \n                        des categories au sens propre du terme ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
