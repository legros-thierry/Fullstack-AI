    },
    {
      "id": "WdTq0dlYzqvMHG-8Y_s93",
      "type": "text",
      "x": 300.3709418426134,
      "y": 570.1028088400504,
      "width": 1614.9962158203125,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a3",
      "roundness": null,
      "seed": 1972698721,
      "version": 96,
      "versionNonce": 2085060961,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790667729871,
      "created": 1790667676285,
      "link": null,
      "locked": false,
      "text": "- modele mathématique entrainé sur des données pour predire des comportements/tendances",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- modele mathématique entrainé sur des données pour predire des comportements/tendances",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "MeuGK3R4LIUbUcAKnteH6",
      "type": "text",
      "x": 501.85955893508464,
      "y": 658.5632828899957,
      "width": 1291.176025390625,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a4",
      "roundness": null,
      "seed": 1535578369,
      "version": 178,
      "versionNonce": 1751978721,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790667802555,
      "created": 1790667739648,
      "link": null,
      "locked": false,
      "text": "=> un algorithme/une fonction mathématique\n        => dont les paramètres ont été mis à jour à partir de données\n            => pour pouvoir predire des tendances/comportements/patterns",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "=> un algorithme/une fonction mathématique\n        => dont les paramètres ont été mis à jour à partir de données\n            => pour pouvoir predire des tendances/comportements/patterns",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "JGtEB5D0cW3_fD5DU1F3Z",
      "type": "text",
      "x": 636.1853036633988,
      "y": 1039.9524509578878,
      "width": 14.399999618530273,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 4,
