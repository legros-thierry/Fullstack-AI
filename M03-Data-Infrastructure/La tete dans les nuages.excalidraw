    {
      "id": "zqeoMsP67Ogny-UJ85dje",
      "type": "text",
      "x": 4564.588792159118,
      "y": 17865.182047976883,
      "width": 1624.42822265625,
      "height": 585,
      "angle": 0,
      "strokeColor": "#f08c00",
