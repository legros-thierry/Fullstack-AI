    {
      "id": "Ud57GGA2Lojn2YZ1N81Cp",
      "type": "text",
      "x": 1835.4073284293718,
      "y": 9596.485013288504,
      "width": 1392.516357421875,
      "height": 405,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aw",
      "roundness": null,
      "seed": 1794153705,
      "version": 577,
      "versionNonce": 1391236329,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790158066709,
      "created": 1790157842929,
      "link": null,
      "locked": false,
      "text": "scalable ? => ce n'est pas simplement un lieu de stockage passif \n                => S3 c'est un lieu de stockage optimisé pour pouvoir\n                    stocker et recuperer la donnée rapidement \n        => qui dit optimisation dit cout \n        => quand je manipule de la donnée de S3 => je paie à sa recuperation \n        => quand on manipule des gros jeux d'images \n            -> la simple recuperation de ces dernieres peut couter quelques euros \n\n=> pour de la donner d'archives on va plutot passer par S3 glacier",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "scalable ? => ce n'est pas simplement un lieu de stockage passif \n                => S3 c'est un lieu de stockage optimisé pour pouvoir\n                    stocker et recuperer la donnée rapidement \n        => qui dit optimisation dit cout \n        => quand je manipule de la donnée de S3 => je paie à sa recuperation \n        => quand on manipule des gros jeux d'images \n            -> la simple recuperation de ces dernieres peut couter quelques euros \n\n=> pour de la donner d'archives on va plutot passer par S3 glacier",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "ziqk0y2M5lWu9yqH6ngqB",
      "type": "text",
      "x": 1462.01427790222,
      "y": 10183.272830243264,
      "width": 1257.371826171875,
      "height": 1080,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ay",
      "roundness": null,
      "seed": 1288984921,
      "version": 1036,
      "versionNonce": 485029111,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790236376688,
      "created": 1790235501429,
      "link": null,
      "locked": false,
      "text": "Recap : le cloud c'est génial, mais pas vraiment\n            => + : flexible, facilement accessible\n                    moins de main d'oeuvre, secure\n                    plus rapidement deployable,\n                    sont à la pointe de l'innovation \n                    - moins cher que si on faisait \n                    soi-meme avec un meme niveau\n                    de qualité et d'innovation \n                    disponibilité et accessibilité \n                    des services -> je deploie une ressource dans aws\n                                        elle est tout de suite dispo\n                                        dans le monde entier \n            \n            => - : c'est relativement cher si on en\n                   est dépendant totalement\n                   souveraineté -> risque RGPD\n                                   -> nos données sont chez quelqu'un d'autre\n                                   -> dépendance technique  \n                    dépend de la qualité des machines\n                        -> si il y a un crash chez aws\n                        mes services sont ko !\n                                => mais par contre il existe\n                                la possibilité de deployer dans plusieurs\n                                région => paye + ",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Recap : le cloud c'est génial, mais pas vraiment\n            => + : flexible, facilement accessible\n                    moins de main d'oeuvre, secure\n                    plus rapidement deployable,\n                    sont à la pointe de l'innovation \n                    - moins cher que si on faisait \n                    soi-meme avec un meme niveau\n                    de qualité et d'innovation \n                    disponibilité et accessibilité \n                    des services -> je deploie une ressource dans aws\n                                        elle est tout de suite dispo\n                                        dans le monde entier \n            \n            => - : c'est relativement cher si on en\n                   est dépendant totalement\n                   souveraineté -> risque RGPD\n                                   -> nos données sont chez quelqu'un d'autre\n                                   -> dépendance technique  \n                    dépend de la qualité des machines\n                        -> si il y a un crash chez aws\n                        mes services sont ko !\n                                => mais par contre il existe\n                                la possibilité de deployer dans plusieurs\n                                région => paye + ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
